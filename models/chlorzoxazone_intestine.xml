    <listOfRules>
      <assignmentRule name="transport of chlorzoxazone out of the lumen" variable="absorption">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>The flux out of the intestinal lumen, which is absorbed (<code>F_czx_abs</code>)
or excreted in the feces (<code>1 - F_czx_abs</code>): the absorption rate
<code>f_Ka_czx</code> does not change the fraction absorbed.</p>
          </body>
        </notes>
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <apply>
            <times/>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci> f_Ka_czx </ci>
                <ci> Ka_abs_czx </ci>
              </apply>
              <cn sbml:units="min_per_hr" type="integer"> 60 </cn>
            </apply>
            <ci> Vgu </ci>
            <ci> czx_lumen </ci>
          </apply>
        </math>
      </assignmentRule>
      <rateRule variable="PODOSE_ethanol">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci> ETHABS </ci>
            </apply>
            <ci> Mr_ethanol </ci>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
    <listOfReactions>
      <reaction sboTerm="SBO:0000655" id="CZXABS" name="absorption chlorzoxazone" reversible="false" compartment="Vgu">
        <listOfReactants>
          <speciesReference species="czx_lumen" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="czx_ext" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> F_czx_abs </ci>
              <ci> absorption </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="ETHABS" name="absorption ethanol" reversible="false" compartment="Vgu">
        <listOfProducts>
          <speciesReference species="ethanol_ext" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <divide/>
                  <ci> Ka_abs_eth </ci>
                  <cn sbml:units="min_per_hr" type="integer"> 60 </cn>
                </apply>
                <ci> PODOSE_ethanol </ci>
              </apply>
              <ci> Mr_ethanol </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="CZXEXC" name="excretion chlorzoxazone (feces)" reversible="false" compartment="Vlumen">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Fraction of the chlorzoxazone in the lumen which is not absorbed.</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="czx_lumen" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="czx_feces" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <ci> F_czx_abs </ci>
              </apply>
              <ci> absorption </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
