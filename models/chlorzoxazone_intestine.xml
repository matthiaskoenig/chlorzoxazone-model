      <parameter sboTerm="SBO:0000647" id="Mr_ethanol" name="Molecular weight ethanol [g/mole]" value="46.07" units="g_per_mole" constant="true"/>
      <parameter id="absorption" name="transport of chlorzoxazone out of the lumen" units="mmole_per_min" constant="false"/>
